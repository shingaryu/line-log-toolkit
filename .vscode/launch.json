{
  // IntelliSense を使用して利用可能な属性を学べます。
  // 既存の属性の説明をホバーして表示します。
  // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python デバッガー: 現在のファイル",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "split  (ログ分割)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "console": "integratedTerminal",
      "args": [
        "split",
        "--input",
        "input/[LINE] まつざわけのトーク.txt",
        "--out",
        "splitted"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "prompt (for chatgpt-web)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "console": "integratedTerminal",
      "args": [
        "prompt",
        "--out",
        "out_prompt",
        "--gdrive-folder",
        "/家族イベント/LINEトーク履歴/月別",
        "--file-pattern",
        "YYYY-MM.txt",
        "--your-name",
        "松澤晃樹"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "reply (by OpenAI API)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "reply",
        "--input-dir", "splitted",
        "--my-name", "松澤晃樹",
        "--months", "4",
        "--instruction-file", "custom_instruction.txt",
        "--model", "gpt-4o-mini",
        // "--model", "gpt-4.1-mini",
        // "--model", "gpt-4.1",
        // "--model", "gpt-5-mini",
        "--n", "3",
        "--context-window", "100",
        "--mode", "decision"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "bot server (LINE Bot)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bot_server.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}